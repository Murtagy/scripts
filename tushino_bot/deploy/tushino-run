#!/usr/bin/env bash
# Synchronize the public menu without replacing the independently managed tunnel.
set -euo pipefail
cd /http/scripts/tushino_bot
set -a
source token.sh
set +a
/http/scripts/tushino_bot/environment/bin/python3 - <<'PY'
import asyncio
import os
from telegram import Bot, MenuButtonWebApp, WebAppInfo

async def synchronize_menu() -> None:
    url = os.environ['WEBAPP_URL']
    if url.rstrip('/') != 'https://slots.murtagy.stream':
        raise RuntimeError('Configure the named slots WebApp URL before starting')
    if os.environ.get('ALLOW_INSECURE_WEBAPP', '0') == '1':
        raise RuntimeError('Telegram WebApp authentication must remain enabled')
    async with Bot(token=os.environ['BOT_TOKEN']) as bot:
        for _ in range(5):
            await bot.set_chat_menu_button(menu_button=MenuButtonWebApp(text='Открыть слоты', web_app=WebAppInfo(url=url)))
            await asyncio.sleep(1)
            menu = await bot.get_chat_menu_button()
            if menu.web_app is not None and menu.web_app.url.rstrip('/') == url.rstrip('/'):
                print(f'Telegram menu URL verified: {url}', flush=True)
                return
        raise RuntimeError('Telegram menu did not adopt configured WebApp URL')

asyncio.run(synchronize_menu())
PY
exec /bin/bash /http/scripts/tushino_bot/run.sh
